# Copy to .env (git-ignored) and adjust if needed.
# Matches the local Postgres from docker-compose.yml.
DATABASE_URL=postgres://coverband:coverband@localhost:5432/coverband

# API port (Scaleway Serverless Containers inject their own PORT).
PORT=3000
# Built web app to serve from the API; leave unset in development (Vite serves it).
# WEB_DIST_DIR=apps/web/dist

# Better Auth. Generate the secret with `openssl rand -base64 32` (at least 32 characters).
BETTER_AUTH_SECRET=
# URL where the browser opens the app: the Vite dev server in development
# (`bun run serve` overrides it with http://localhost:3000). Logins from any other origin are refused.
BETTER_AUTH_URL=http://localhost:5173
# Other origins allowed to log in, comma-separated. `bun run dev:lan` sets it (and BETTER_AUTH_URL) itself.
# TRUSTED_ORIGINS=
# Reverse proxies (IPs or CIDR ranges, comma-separated) skipped when reading the client IP from
# X-Forwarded-For. Leave empty unless the production check shows several addresses in the header.
# TRUSTED_PROXIES=

# `bun run dev:lan` finds your LAN IP; set it here if it picks the wrong one.
# DEV_HOST=192.168.1.20

# Default admin, created at startup if no user has this email (never modified afterwards).
# Password: at least 12 characters. Leave both unset to skip.
ADMIN_EMAIL=admin@coverband.localhost
ADMIN_PASSWORD=

# Outgoing email (SMTP). Locally: Mailpit from docker-compose, read emails at http://localhost:8025.
# Production: Scaleway TEM (smtp.tem.scaleway.com, port 465 with SMTP_SECURE=true,
# SMTP_USER = project ID, SMTP_PASSWORD = API secret key) and a verified sending domain.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Coverband <noreply@coverband.localhost>"
# Only for tests: Mailpit's API, to check that emails really arrive.
MAILPIT_URL=http://localhost:8025

# Object storage (S3 API). Locally: Garage from docker-compose (`bun run db:up` creates the bucket and
# this development key, see docker/garage/init.sh). Production: Scaleway Object Storage
# (S3_ENDPOINT=https://s3.fr-par.scw.cloud, S3_REGION=fr-par, a private bucket, an API key).
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=coverband
S3_ACCESS_KEY_ID=GKc0ffeeb0a7d0000000000001
S3_SECRET_ACCESS_KEY=c0ffeeb0a7d0c0ffeeb0a7d0c0ffeeb0a7d0c0ffeeb0a7d0c0ffeeb0a7d00001
