{
  "name": "coverband",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "bun --env-file=.env run --parallel --filter './apps/*' dev",
    "dev:lan": "bun --env-file=.env apps/api/src/dev/lan.ts",
    "dev:api": "bun --env-file=.env run --filter @coverband/api dev",
    "dev:web": "bun run --filter @coverband/web dev",
    "build": "bun run --filter @coverband/web build",
    "serve": "WEB_DIST_DIR=apps/web/dist BETTER_AUTH_URL=http://localhost:3000 bun --env-file=.env apps/api/src/main.ts",
    "serve:lan": "bun run build && bun --env-file=.env apps/api/src/dev/serve-lan.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "e2e": "bun --env-file=.env run --filter @coverband/e2e e2e",
    "db:up": "docker compose up -d --wait db mailpit garage garage-webui && sh docker/garage/init.sh",
    "db:down": "docker compose down",
    "db:generate": "bun --env-file=.env run --filter @coverband/api db:generate",
    "db:migrate": "bun --env-file=.env run --filter @coverband/api db:migrate",
    "mail:test": "bun --env-file=.env apps/api/src/adapters/mail/send-test.ts",
    "db:studio": "bun --env-file=.env run --filter @coverband/api db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
